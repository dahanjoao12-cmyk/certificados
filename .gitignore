# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Claude Code local session settings (can contain machine-specific permission
# rules with sensitive command strings) -- .claude/launch.json is fine to share.
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Dados reais de clientes: planilhas de importação e certificados NUNCA devem
# ser versionados. Use as pastas abaixo como área de trabalho local apenas.
# ---------------------------------------------------------------------------
/dados-reais/
/tmp-uploads/
/import-data/
*.pfx
*.p12
*.xlsx
*.xls
*.csv
!supabase/seed.sql
!**/fixtures/**/*.csv
!**/fixtures/**/*.xlsx
