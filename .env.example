# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# NUNCA commite .env.local (já está no .gitignore).

# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Service role key: NUNCA exponha no frontend. Usada apenas em código de
# servidor (Server Actions / Route Handlers) para operações administrativas,
# como criação de usuários pelo admin.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta

# Envio de e-mail (Resend: https://resend.com). Usado para convite de
# usuário e notificação de certificados vencendo.
RESEND_API_KEY=sua-api-key-da-resend
EMAIL_FROM=Certificados Digitais <onboarding@resend.dev>

# Segredo para proteger a rota de cron de notificação por e-mail. Gere um
# valor aleatório (ex.: `openssl rand -hex 24`) e configure o mesmo valor
# como variável de ambiente CRON_SECRET no projeto Vercel.
CRON_SECRET=um-valor-aleatorio-qualquer

# URL pública do app, usada para montar links nos e-mails. Em produção,
# defina como a URL real do projeto na Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000
