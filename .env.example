# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# NUNCA commite .env.local (já está no .gitignore).

# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Service role key: NUNCA exponha no frontend. Usada apenas em código de
# servidor (Server Actions / Route Handlers) para operações administrativas,
# como criação de usuários pelo admin.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta
